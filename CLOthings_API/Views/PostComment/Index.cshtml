@model IEnumerable<CLOthings_API.Models.PostComment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ParentCommentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CommunityPostId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CommentText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CommentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CommunityPost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InverseParentComment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParentComment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ParentCommentId)
            </td>
            <td>
                @Html.DisplayFor(model => item.CommunityPostId)
            </td>
            <td>
                @Html.DisplayFor(model => item.UserId)
            </td>
            <td>
                @Html.DisplayFor(model => item.CommentText)
            </td>
            <td>
                @Html.DisplayFor(model => item.CommentDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.CommunityPost)
            </td>
            <td>
                @Html.DisplayFor(model => item.InverseParentComment)
            </td>
            <td>
                @Html.DisplayFor(model => item.ParentComment)
            </td>
            <td>
                @Html.DisplayFor(model => item.User)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PostCommentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PostCommentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PostCommentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
